{
  "version": 2,
  "builds": [
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/sermons", "dest": "api/sermons.py" },
    { "src": "/api/sermon/(\\d+)", "dest": "api/sermon.py" },
    { "src": "/sermon/(\\d+)", "dest": "/detail.html" },
    { "src": "/(manifest|sw)\\.json|js", "dest": "/$1.$2" },
    { "src": "/logo\\.png", "dest": "/logo.png" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "env": {
    "FLASK_BACKEND_URL": "https://your-home-server.example.com"
  }
}
