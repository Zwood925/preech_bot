{
  "expo": {
    "name": "Preech Bot",
    "slug": "preech-bot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.preechbot.app",
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#070A12"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3e7ad03a-1632-4ea7-9cc3-a2243ed1ab57"
      }
    }
  }
}